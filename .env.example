# Copy to .env.local for local development. Never commit real values.

# Supabase (Project settings → API). Use an EU/UK region (spec §11).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inngest. Locally: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev`.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (optional; errors are only reported when set).
SENTRY_DSN=
