# Copy to .env.local for local development. Never commit real values.

# Supabase (Project settings → API). Use an EU/UK region (spec §11).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inngest. Locally: set INNGEST_DEV=1 and run `npx inngest-cli@latest dev`.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (optional; errors are only reported when set).
SENTRY_DSN=

# Google OAuth client (Google Cloud → APIs & Services → Credentials, type "Web
# application"). Authorised redirect URI: <SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API access comes from the Google Cloud project that owns the
# OAuth client above (developer tokens were retired on 9 Sept 2026). Enable the
# Google Ads API there and apply for Explorer access on its Overview page.
# Optional: override the API version (default in src/lib/ads/adsClient.ts).
# GOOGLE_ADS_API_VERSION=v26
# Daily operations for your access level (Explorer 2880, Basic 15000).
GOOGLE_ADS_DAILY_OPERATION_LIMIT=2880
# Encrypts stored refresh tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Set to the old key while rotating keys.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=
